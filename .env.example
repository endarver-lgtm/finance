# Windows / без IPv6: используйте Session pooler (Connect → вкладка с pooler, порт 5432)
# НЕ db.xxx.supabase.co — только IPv6, часто даёт "Name or service not known"
#
# Скопируйте URI из Supabase → Connect (рядом с Direct есть Session / Pooler)
# Пример формата (регион и хост возьмите из своего дашборда):
DATABASE_URL=postgresql://postgres.rvnjzymgjyyauwufwcmz:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

SECRET_KEY=change-me-to-random-string
DEFAULT_CURRENCY=€
