# Скопируйте в .env и подставьте свои значения:
#   copy .env.example .env

# Обязательно: строка подключения Postgres из Supabase
# Dashboard → Project Settings → Database → Connection string → URI
# Для Render: Session pooler :5432 или Transaction :6543 (не Direct db.* — часто только IPv6).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Секрет Flask (сессии / flash). На Render сгенерируйте длинную случайную строку.
SECRET_KEY=change-me-to-a-long-random-string

# Опционально
DEFAULT_CURRENCY=BYN
USD_RATE=3.27
