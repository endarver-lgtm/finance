# Опционально: скопируйте в .env при необходимости изменить настройки
#   copy .env.example .env

# Путь к файлу базы данных SQLite (по умолчанию: finance.db в корне проекта)
# DATABASE_PATH=finance.db

# Секрет Flask (сессии / flash)
# SECRET_KEY=dev-change-me-in-production

# Базовая валюта и курсы по умолчанию
# DEFAULT_CURRENCY=BYN
# USD_RATE=3.27
# EUR_RATE=3.55
